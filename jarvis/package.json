{
  "name": "jarvis-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "A voice-first thinking partner that turns rough ideas into concrete next steps, using only Claude.",
  "type": "module",
  "scripts": {
    "start": "node desktop.js",
    "serve": "node server.js",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  }
}
